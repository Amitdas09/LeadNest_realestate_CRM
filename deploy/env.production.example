# Copy to ~/leadnest/.env.production on the server and fill in. Never commit the real file.

# Public address of the CRM (free DuckDNS name, e.g. leadnest.duckdns.org)
DOMAIN=yourname.duckdns.org

# Database password (any long random string; only used inside the server)
POSTGRES_PASSWORD=change-me

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

BUSINESS_NAME=Your Business Name
TIMEZONE=Asia/Kolkata

# Google Sheet lead source (key file goes in ~/leadnest/secrets/google-service-account.json)
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
GOOGLE_SHEET_ID=paste-the-id-from-the-sheet-url

# WhatsApp: put the token/secret values in ~/leadnest/secrets/whatsapp.env (same format as locally).
WHATSAPP_VERIFY_TOKEN=generate-a-random-string
