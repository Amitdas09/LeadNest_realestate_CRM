# Copy this file to .env and fill in the values. Never commit .env.

# Client-specific settings (one install per client)
BUSINESS_NAME=Your Business Name
TIMEZONE=Asia/Kolkata

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-value

# Local services from infra/docker-compose.yml
POSTGRES_PASSWORD=leadflow
DATABASE_URL=postgresql+psycopg://leadflow:leadflow@127.0.0.1:5433/leadflow
REDIS_URL=redis://127.0.0.1:6379/0

# Auth
ACCESS_TOKEN_MINUTES=720

# Frontend origin(s) allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:5173"]

# Google Sheet lead source (share the sheet with the service account email as Viewer)
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
GOOGLE_SHEET_ID=paste-the-id-from-the-sheet-url


# Random string used when registering the webhook with Meta
WHATSAPP_VERIFY_TOKEN=generate-a-random-string

# WhatsApp Cloud API — keep the real values in secrets/whatsapp.env (git-ignored).
# Find them in developers.facebook.com → your app → WhatsApp → API Setup / App settings → Basic.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v25.0
# WHATSAPP_OPENING_TEMPLATE=hello_world
# WHATSAPP_OPENING_TEMPLATE_LANG=en_US

